{
  "name": "sc-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "opennextjs-cloudflare build",
    "dev": "next dev",
    "start": "next start",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "build:next": "next build"
  },
  "dependencies": {
    "@fuma-translate/react": "^1.0.2",
    "@mingcute/react": "3.0.2",
    "@opennextjs/cloudflare": "^1.20.18",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-presence": "^1.1.11",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "16.16.2",
    "fumadocs-mdx": "15.4.6",
    "fumadocs-ui": "16.16.2",
    "i18next": "^27.2.2",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-remove-scroll": "^2.7.2",
    "scroll-into-view-if-needed": "^3.2.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
